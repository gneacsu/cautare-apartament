# Copiază în .env LÂNGĂ app.py. Nu în .venv. Nu publica cheile.
GEMINI_API_KEY=
SERPAPI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=medium

# Plafon per apel Gemini (include gândirea); NU plafon total pe analiză.
MAX_OUTPUT_TOKENS=8192
COMPARISON_BATCH_SIZE=3

# Rundă reluabilă; pașii finalizați nu se repetă.
ANALYSIS_SECONDS=900
HTTP_SECONDS=12
SEARCH_SECONDS=60
PAGES_PER_QUERY=2
MAX_FOLLOWUP_QUERIES=4
MAX_INPUT_CHARS=16000
MAX_CANDIDATE_CHARS=8000
MAX_IMAGES_PER_LISTING=6
# Vechile MAX_CANDIDATES / MAX_SEARCHES / MAX_AI_CALLS nu limitează fluxul SerpApi.
