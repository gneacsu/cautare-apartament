# Copiază în .env. Completează cheia doar în fișierul local, exclus din Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=medium

# Limite pe analiză; toate valorile sunt citite în src/config.py.
ANALYSIS_SECONDS=600
HTTP_SECONDS=12
MAX_INPUT_CHARS=16000
MAX_CANDIDATE_CHARS=8000
MAX_CANDIDATES=20
MAX_SEARCHES=6
SEARCH_RESULTS_PER_CALL=8
MAX_AI_CALLS=20
# Compare cel mult trei surse într-un apel, fără a reduce totalul de candidați.
COMPARISON_BATCH_SIZE=3
# Plafonul include și tokenii de gândire, nu doar textul rezultatului.
MAX_OUTPUT_TOKENS=8192
