# Copiază în .env. Completează cheia doar în fișierul local, exclus din Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Limite pe analiză; toate valorile sunt citite în src/config.py.
ANALYSIS_SECONDS=150
HTTP_SECONDS=12
MAX_INPUT_CHARS=12000
MAX_CANDIDATE_CHARS=7000
MAX_CANDIDATES=6
MAX_SEARCHES=2
MAX_AI_CALLS=5
MAX_OUTPUT_TOKENS=3000
